{
  "id": "com.aurabeat.addon",
  "name": "AuraBeat Audio Addon",
  "version": "2.0.0",
  "description": "High fidelity audio addon supporting Hi-Res Lossless, Dolby Atmos, 300% Stereo Expand, and AutoMix Neural DJ Transitions",
  "resources": [
    "search",
    "stream",
    "automix"
  ],
  "bitchordAuth": true,
  "automix": true,
  "features": [
    "hires_lossless",
    "dolby_atmos",
    "stereo_expand_300",
    "automix_neural_transitions"
  ],
  "settings": [
    {
      "key": "quality",
      "type": "select",
      "default": "lossless",
      "options": [
        { "value": "lossless", "label": "Hi-Res Lossless (FLAC 24-bit/96kHz)" },
        { "value": "expand", "label": "300% Stereo Expand (Spatial Audio 3.0x)" },
        { "value": "atmos", "label": "Dolby Atmos (Spatial Audio E-AC-3 JOC)" },
        { "value": "high", "label": "High Quality (AAC 320 kbps)" },
        { "value": "medium", "label": "Standard Quality (AAC 256 kbps)" },
        { "value": "low", "label": "Data-Saver (AAC 128 kbps)" }
      ]
    },
    {
      "key": "automix_mode",
      "type": "select",
      "default": "smart",
      "label": "AutoMix Transition Style",
      "options": [
        { "value": "smart", "label": "Smart AI Transition (Auto Blend & Filter)" },
        { "value": "dj_blend", "label": "Neural DJ Blend (Bass Swap Handover)" },
        { "value": "dj_filter", "label": "Neural DJ Filter Sweep (24 dB/oct Low/High-Pass)" },
        { "value": "stem_safe", "label": "Neural Stem & Vocal Safe (Vocal Anti-Clash)" },
        { "value": "equal_power", "label": "Constant Power Crossfade (Flat Faders)" }
      ]
    }
  ]
}
