# Public hostnames where users access your addon (comma-separated, no scheme, no port)
BITCHORD_HOSTS=localhost,myaddon.example.com,myaddon.onrender.com

# Auth mode: 'enforce' (blocks unauthenticated clients with 401) or 'log' (allows rollout testing)
BITCHORD_AUTH_MODE=enforce

# Secret key used for signing short-lived media URLs (keep private)
MEDIA_SECRET=your-secure-random-secret-key-here

PORT=3000
